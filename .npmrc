# The bundle build stages a self-contained node_modules into
# packages/dsh-next-app/web (tsdown.config.ts) so the packed app resolves its
# extra dependencies at profile runtime. pnpm's pre-run dep check treats that
# staged install as a dirty modules directory and wants to purge it on every
# command (aborting without a TTY). Verification stays explicit: CI runs
# `pnpm install --frozen-lockfile` before anything else, and the staged dir
# is regenerated by every build.
verify-deps-before-run=false
