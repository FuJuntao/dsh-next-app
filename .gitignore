# dependencies
node_modules/
.pnpm-store

# Next.js builds
.next/
out/
dist/

# env — the shape belongs in .env.example, values never
.env
.env.local
.env.*.local

# build info
*.tsbuildinfo

# dsh-next-app bundle: emitted glue (built at pack time)
packages/dsh-next-app/lib/
# dsh-next-app bundle: staged app build (the pack pipeline copies apps/web's build here)
packages/dsh-next-app/web/
# dsh-next-app bundle: the packed tarball itself (deploy artifact, never commit)
scope-dsh-next-app-*.tgz

# e2e scratch projects (slash-roster.spec.ts): fixture folders a spec creates
# inside the instance's default working folder - the fence's own subtree - and
# removes in afterAll; ignored so a crashed run cannot dirty the checkout.
/e2e-slash-*

# logs & misc
*.log
.DS_Store
coverage/
playwright-report/
test-results/
.e2e-state.json
