{
  "name": "@scope/dsh-next-app",
  "version": "0.0.0",
  "description": "The published dsh-next-app bundle: dsh.bundle.patch, cordis.patch.yml, and the lib/ glue that spawns and supervises the built Next app inside its own dsh profile (ADR-0002). The scope in the name is a placeholder - the real npm scope is decided before the first publish.",
  "files": [
    "dsh.bundle.patch",
    "cordis.patch.yml",
    "lib",
    "web"
  ],
  "type": "module",
  "exports": {
    "./cli": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./runtime": {
      "types": "./lib/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --filter web run build && tsdown",
    "prepack": "pnpm run build",
    "lint": "oxlint --type-aware --type-check .",
    "format": "oxfmt ."
  },
  "dependencies": {
    "commander": "^15.0.0",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-cmdline": "catalog:",
    "@deepseek-ai/dsh-subprocess": "catalog:",
    "@tsconfig/node-ts": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-cmdline": "catalog:",
    "@deepseek-ai/dsh-subprocess": "catalog:"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}